{
  "name": "bigxreality-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "assets": "node scripts/build-fonts.mjs && node scripts/make-favicons.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "qa:links": "node scripts/check-links.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:shots": "node scripts/qa-screenshots.mjs",
    "favicons": "node scripts/make-favicons.mjs",
    "qa:behaviour": "node scripts/qa-behaviour.mjs",
    "qa:news-preview": "node scripts/pages/package.mjs && node scripts/qa-news-preview.mjs",
    "qa:news-media": "node scripts/qa-news-media.mjs",
    "qa:news-import": "node scripts/qa-historical-news.mjs",
    "qa:images": "node scripts/qa-uploaded-images.mjs",
    "qa:seo": "node scripts/qa-seo.mjs",
    "qa:motion": "node scripts/qa-micro-interactions.mjs",
    "qa:density-navigation": "node scripts/qa-density-navigation.mjs",
    "qa:header": "node scripts/qa-header.mjs",
    "qa:footer": "node scripts/qa-footer.mjs",
    "qa:solutions": "node scripts/qa-solutions.mjs",
    "qa:solution-heroes": "node scripts/qa-solution-heroes.mjs",
    "qa:team": "node scripts/qa-team-page.mjs",
    "qa:company": "node scripts/qa-company.mjs",
    "qa:english": "node scripts/qa-english.mjs",
    "qa:japanese": "node scripts/qa-japanese.mjs",
    "qa:faq": "node scripts/qa-faq.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "build:fixtures": "BXR_CONTENT_SOURCE=fixtures npm run build",
    "postbuild": "node scripts/build-search.mjs",
    "qa:search": "QA_DIST=dist-fixtures node scripts/qa-search.mjs",
    "qa:technologies": "node scripts/qa-technologies.mjs",
    "qa:technologies-overview-layout": "node scripts/qa-technologies-overview-layout.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "qa:phase2": "QA_DIST=dist-fixtures node scripts/qa-phase2.mjs",
    "qa:ui-language": "node scripts/qa-ui-language.mjs",
    "qa:csr": "node scripts/qa-csr.mjs",
    "qa:client-logos": "node scripts/qa-client-logos.mjs",
    "qa:ui-v1": "node scripts/qa-ui-v1.mjs",
    "qa:ui-v1-preview": "node scripts/pages/package.mjs && node scripts/qa-ui-v1-preview.mjs",
    "qa:hero-framing": "node scripts/qa-hero-framing.mjs",
    "cms:sveltia:generate": "node scripts/sveltia/generate.mjs",
    "cms:sveltia:check": "node scripts/sveltia/generate.mjs --check && node scripts/sveltia/check.mjs",
    "qa:sveltia": "node scripts/sveltia/qa-browser.mjs",
    "qa:media-composition": "node scripts/qa-media-composition.mjs",
    "qa:visual-review": "node scripts/qa-visual-review.mjs",
    "qa:typography": "node scripts/qa-typography.mjs",
    "pages:build": "BXR_CONTENT_SOURCE=markdown BXR_PREVIEW=0 npm run build && npm run pages:package && npm run pages:check",
    "pages:package": "node scripts/pages/package.mjs",
    "pages:check": "node scripts/pages/check.mjs",
    "qa:cms-publication": "node scripts/qa-cms-publication.mjs",
    "qa:inquiry-poc": "node scripts/qa-inquiry-poc.mjs",
    "qa:inquiry-production": "node scripts/pages/package.mjs && node scripts/qa-inquiry-production.mjs",
    "qa:inquiry-production:live": "INQUIRY_LIVE=1 npm run qa:inquiry-production"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource/b612-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "astro": "7.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "lighthouse": "13.5.0",
    "marked": "17.0.6",
    "pagefind": "1.5.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
