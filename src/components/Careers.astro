---
import type { Lang } from '../i18n';
import { localePath } from '../i18n';
import { getUi } from '../lib/ui';
import Text from './Text.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getUi(lang).careers;
---
<section class="section careers" id="careers" aria-labelledby="careers-title" data-careers>
  <div class="container">
    <h2 class="t-h2" id="careers-title"><Text value={t.title} /></h2>
    <p><Text value={t.description} /></p>
    <a class="btn btn--primary" href={localePath(lang, 'company', 'careers')} data-careers-page><Text value={t.about} /></a>
  </div>
</section>
<style>
  .careers { border-top: 1px solid var(--divider); }
  .container { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .container > p { margin: 0; max-width: 72ch; }
  .btn { justify-self: start; }
</style>
