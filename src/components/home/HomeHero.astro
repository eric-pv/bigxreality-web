---
/**
 * Home hero: approved BXR training footage (muted, no audio track) behind the H1.
 * The poster image is always rendered and is what search engines, no-JS visitors,
 * reduced-motion and Save-Data users see. The two clips play one after the other
 * (docs/PLAN.md §4.3); the second is only fetched once the first is playing, and a
 * pause button is shown because the loop runs longer than five seconds (WCAG 2.2.2).
 */
import { Picture } from "astro:assets";
import poster from "../../assets/images/home/hero-poster.webp";
import type { HomeCopy } from "../../data/home";
import Text from "../Text.astro";
import { heroClips } from "../../data/hero-clips";

interface Props { copy: HomeCopy["hero"]; primaryHref: string; secondaryHref: string }
const { copy, primaryHref, secondaryHref } = Astro.props;
const clips = heroClips;
---
<section class="hero" data-theme="dark" aria-labelledby="home-title" data-hero>
  <div class="media">
    <Picture src={poster} alt={copy.posterAlt} formats={["avif", "webp"]} widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" class="poster" />
    {clips.map((c) => (
      <video muted playsinline preload="none" aria-label={copy.videoLabel} data-clip hidden style={`--clip-desktop:${c.desktopPosition};--clip-mobile:${c.mobilePosition}`}>
        <source data-src={`${c.src}.webm`} type="video/webm" />
        <source data-src={`${c.src}.mp4`} type="video/mp4" />
      </video>
    ))}
    <div class="shade" aria-hidden="true"></div>
    <div class="hud" aria-hidden="true" data-motion-loop>
      <span class="sweep"></span>
      <span class="frame"><span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span></span>
    </div>
  </div>
  <div class="container inner">
    <p class="t-label eyebrow">{copy.eyebrow}</p>
    <h1 class="t-h1 title" id="home-title"><Text value={copy.title} /></h1>
    <p class="subtitle t-h3"><Text value={copy.subtitle} /></p>
    <p class="desc"><Text value={copy.description} /></p>
    <div class="actions">
      <a class="btn btn--primary" href={primaryHref}><Text value={copy.primary} /></a>
      <a class="btn btn--secondary" href={secondaryHref}><Text value={copy.secondary} /></a>
    </div>
  </div>
  <button type="button" class="toggle keyboard-control" data-toggle hidden aria-pressed="false" data-pause={copy.pause} data-play={copy.play} aria-label={copy.pause}>
    <svg class="i-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor" /></svg>
    <svg class="i-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 2l10 6-10 6z" fill="currentColor" /></svg>
  </button>
</section>

<script>
  function initializeHero() {
    const root = document.querySelector<HTMLElement>("[data-hero]");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const clips = [...root.querySelectorAll<HTMLVideoElement>("[data-clip]")];
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const controller = new AbortController(), options = { signal: controller.signal };
    let current = 0, paused = false, switching = false;
    const load = (video: HTMLVideoElement) => {
      if (video.dataset.loaded) return;
      video.querySelectorAll<HTMLSourceElement>("source").forEach(source => { source.src = source.dataset.src!; });
      video.load(); video.dataset.loaded = "1";
    };
    const updateControl = () => {
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.play : toggle.dataset.pause)!);
    };
    const show = async (index: number) => {
      if (switching || paused || motion.matches || saveData || document.hidden) return;
      switching = true;
      const next = clips[index]; load(next);
      next.currentTime = 0;
      // Keep the previous last frame/poster until the next decoded frame actually plays.
      let resolvePlaying: () => void, rejectPlaying: () => void;
      const playing = new Promise<void>((resolve,reject) => { resolvePlaying=resolve;rejectPlaying=reject; });
      const onPlaying=()=>resolvePlaying(),onError=()=>rejectPlaying();
      next.addEventListener('playing',onPlaying,{once:true,signal:controller.signal});
      next.addEventListener('error',onError,{once:true,signal:controller.signal});
      try {
        await next.play(); await playing;
        if (paused || motion.matches) { next.pause(); return; }
        const previous = clips[current]; current = index;
        clips.forEach((video,i) => video.classList.toggle('is-on',i===index));
        root.dataset.currentClip = String(index);
        if (previous !== next) previous.pause();
        load(clips[(index+1)%clips.length]);
      } catch { /* The poster/previous decoded frame remains available. */ }
      finally {
        next.removeEventListener('playing',onPlaying);next.removeEventListener('error',onError);
        switching = false;
      }
    };
    clips.forEach((video,index) => {
      video.hidden = false; video.muted = true;
      video.addEventListener('ended',()=>{ if(index===current) void show((index+1)%clips.length); },options);
    });
    toggle.hidden = false;
    toggle.addEventListener('click',()=>{
      paused = !paused; updateControl();
      if(paused) clips.forEach(video=>video.pause());
      else { if(motion.matches || saveData) { paused=true;updateControl(); } else if(clips[current].ended) void show((current+1)%clips.length); else {load(clips[current]);clips[current].play().catch(()=>{});} }
    },options);
    const applyPreference = () => {
      if(motion.matches || saveData){clips.forEach(video=>video.pause());paused=true;updateControl();}
      else {paused=false;updateControl();void show(current);}
    };
    motion.addEventListener('change',applyPreference,options);
    document.addEventListener('visibilitychange',()=>{
      if(document.hidden) clips.forEach(video=>video.pause());
      else if(!paused&&!motion.matches&&!saveData) { if(clips[current].ended)void show((current+1)%clips.length);else clips[current].play().catch(()=>{}); }
    },options);
    window.addEventListener('pagehide',()=>clips.forEach(video=>video.pause()),options);
    window.addEventListener('pageshow',event=>{if(event.persisted&&!paused&&!motion.matches&&!saveData)clips[current].play().catch(()=>{});},options);
    document.addEventListener('astro:before-swap',()=>{controller.abort();clips.forEach(video=>video.pause());},{once:true,signal:controller.signal});
    applyPreference();
  }
  initializeHero();
  document.addEventListener('astro:page-load',initializeHero);
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; background: var(--bxr-black); color: var(--bxr-white); display: flex; align-items: center; min-height: clamp(480px, 70vh, 600px); }
  .media, .media :global(picture), .media :global(img), .media video, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .media { z-index: -1; }
  .media :global(img), .media video { object-fit: cover; object-position: 50% 0%; }
  .media video { opacity: 0; transition: opacity 600ms var(--ease-precise); }
  .media video.is-on { opacity: 1; }
  .shade { background: linear-gradient(90deg, rgb(11 15 20 / 0.92) 0%, rgb(11 15 20 / 0.72) 45%, rgb(11 15 20 / 0.25) 100%); }
  .inner { position: relative; display: grid; gap: var(--space-2); padding-block: var(--space-8); }
  .inner > * { max-width: 40rem; }
  .inner > .title { max-width: 52rem; }
  .eyebrow { color: var(--bxr-ash); }
  .title { color: var(--bxr-white); font-size: var(--fs-display); line-height: var(--lh-display); letter-spacing: var(--ls-display); }
  :lang(zh) .title, :lang(ja) .title { font-size: calc(var(--fs-display) * 0.8); line-height: 1.2; letter-spacing: 0.02em; }
  .subtitle { color: var(--bxr-white); }
  .desc { color: var(--bxr-ash); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .toggle {
    position: absolute; right: var(--margin); bottom: var(--space-3); display: grid; place-items: center; width: 40px; height: 40px;
    border: 1px solid rgb(255 255 255 / 0.5); border-radius: 50%; background: rgb(11 15 20 / 0.5); color: var(--bxr-white); cursor: pointer;
  }
  .toggle[hidden] { display: none; }
  .toggle:hover { border-color: var(--bxr-white); }
  .toggle .i-play, .toggle[aria-pressed="true"] .i-pause { display: none; }
  .toggle[aria-pressed="true"] .i-play { display: block; }
  @media (max-width: 1023px) {
    .title { font-size: calc(var(--fs-display) * 0.8); }
    :lang(zh) .title, :lang(ja) .title { font-size: calc(var(--fs-display) * 0.66); }
  }
  @media (max-width: 767px) {
    .hero { min-height: 0; }
    .inner { padding-block: var(--space-6) var(--space-8); }
    .title, :lang(zh) .title, :lang(ja) .title { font-size: var(--fs-h1); line-height: 1.25; }
    .shade { background: linear-gradient(180deg, rgb(11 15 20 / 0.6) 0%, rgb(11 15 20 / 0.88) 60%); }
  }
</style>

<style>
/* Full landscape footage on smaller screens: no face cropping and no dark film over the video.
   Copy stays readable in its own brand-colored area below the footage. */
@media(max-width:1023px) {
 .hero { display: block; min-height: 0; }
 .media { position: relative; inset: auto; width: 100%; height: auto; aspect-ratio: 16 / 9; z-index: 0; }
 .media :global(img),.media video { object-fit: contain; object-position: 50% 0%; }
 .shade { background: none; }
 .inner { background: var(--bxr-black); padding-block: 28px 40px; }
 .toggle { top: calc(56.25vw - 52px); bottom: auto; width: 44px; height: 44px; z-index: 2; }
}
</style>

<style>
/* The whole landscape frame sits on a subdued extension of the approved poster. */
@media(min-width:1024px) {
 .hero { min-height:clamp(520px,43vw,640px); }
 .media :global(.poster) { object-fit:contain; object-position:100% 50%; }
 .hero[data-current-clip] .media :global(.poster) { object-fit:cover;filter:blur(20px);opacity:.3; }
 .media video { object-fit:contain; object-position:var(--clip-desktop); }
 .shade { background:linear-gradient(90deg,#0b0f14 0%,rgb(11 15 20 / .96) 18%,rgb(11 15 20 / .87) 33%,rgb(11 15 20 / .25) 50%,transparent 70%,rgb(11 15 20 / .22)); }
 .inner > * { max-width:34rem; }
 .inner > .title { max-width:38rem; }
 .title { font-size:clamp(36px,3.8vw,52px); }
}
.desc,.eyebrow { color:#e4e8ed; }
.keyboard-control { left:var(--margin); right:auto; top:12px; bottom:auto; width:auto; height:auto; padding:12px; border-radius:4px; opacity:0; pointer-events:none; transform:translateY(-160%); }
.keyboard-control:focus-visible { opacity:1; pointer-events:auto; transform:none; outline:3px solid white; outline-offset:3px; z-index:5; }
@media(max-width:1023px) {
 .media video { object-fit:contain;object-position:var(--clip-mobile); }
 .keyboard-control { top:12px;bottom:auto; }
}
@media(prefers-reduced-motion:reduce) { .media video { transition:none; } }
</style>

<style>
@media(min-width:1024px) and (max-width:1199px) {
 .hero { display:block;min-height:0; }
 .media { position:relative;inset:auto;aspect-ratio:16/9;height:auto;z-index:0; }
 .media video,.media :global(.poster) { object-fit:contain;object-position:var(--clip-mobile,50% 50%); }
 .shade { background:none; }
 .inner { background:var(--bxr-black);padding-block:28px 40px; }
 .inner > *, .inner > .title { max-width:48rem; }
}
</style>
<style>
@media(min-width:1200px) {
 .inner > *, .inner > .title { max-width:min(32vw,34rem); }
 .media video,.media :global(img.poster) { width:70%;left:auto;right:0;object-fit:contain;object-position:var(--clip-desktop,100% 50%); }
 .hero[data-current-clip] .media :global(img.poster) { width:100%;left:0;object-fit:cover; }
}
</style>
<style>
@media(min-width:1200px) {
 .media video { mask-image:linear-gradient(90deg,transparent,black 8%,black 96%,transparent),linear-gradient(180deg,transparent,black 12%,black 88%,transparent);mask-composite:intersect; }
}
@media(max-width:1199px) { .media video { filter:brightness(1.08); } }
</style>
<style>
/* Tactical HUD over the footage: decorative only (aria-hidden, no pointer events).
   Static frame + texture without JS; entrance and sweep need the motion controller. */
.hud { position:absolute; inset:0; z-index:1; overflow:hidden; pointer-events:none; --corner:28px; --corner-gap:16px; }
.hud::before { content:""; position:absolute; inset:0; opacity:.06;
  background:repeating-linear-gradient(180deg,var(--bxr-white) 0 1px,transparent 1px 4px),
    linear-gradient(90deg,var(--bxr-white) 1px,transparent 1px) 0 0/64px 64px,
    linear-gradient(180deg,var(--bxr-white) 1px,transparent 1px) 0 0/64px 64px; }
.sweep { position:absolute; inset:0; transform:translateY(-100%); }
.sweep::after { content:""; position:absolute; inset:auto 0 0; height:56px; border-bottom:1px solid color-mix(in srgb,var(--bxr-red) 55%,transparent);
  background:linear-gradient(180deg,transparent,color-mix(in srgb,var(--bxr-red) 10%,transparent)); }
.frame { position:absolute; inset:var(--corner-gap); }
.corner { position:absolute; width:var(--corner); height:var(--corner); border:0 solid var(--bxr-red); }
.tl { top:0; left:0; border-width:2px 0 0 2px; --from:translate(calc(-1 * var(--corner-gap)),calc(-1 * var(--corner-gap))); }
.tr { top:0; right:0; border-width:2px 2px 0 0; --from:translate(var(--corner-gap),calc(-1 * var(--corner-gap))); }
.bl { bottom:0; left:0; border-width:0 0 2px 2px; --from:translate(calc(-1 * var(--corner-gap)),var(--corner-gap)); }
.br { bottom:0; right:0; border-width:0 2px 2px 0; --from:translate(var(--corner-gap),var(--corner-gap)); }
@media(min-width:1200px) {
 /* Frame the rendered 16:9 footage (right 70%, contain), not the whole hero. */
 .media { container-type:size; }
 .hud { inset:auto 0 auto auto; top:50%; width:min(70cqw,100cqh * 16 / 9); height:min(100cqh,70cqw * 9 / 16); transform:translateY(-50%); }
 /* The footage's left quarter fades under the copy column: keep frame, sweep and texture clear of the text. */
 .frame { left:24%; }
 .sweep { left:24%; }
 .hud::before { mask-image:linear-gradient(90deg,transparent 20%,black 32%); }
}
@media(max-width:767px) { .hud { --corner:14px; --corner-gap:8px; } }

/* Title underline is created by src/scripts/micro-interactions.ts (the line reveal is a clip-path animation on the H1). */
.title { position:relative; }
.title :global(.hero-key) { position:absolute; inset:0; pointer-events:none; }
.title :global(.hero-key i) { position:absolute; height:2px; background:var(--bxr-red); transform-origin:0 50%; }
.eyebrow :global(.type-visual > span) { position:relative; }
.eyebrow :global(.type-visual > span.last::after) { content:"_"; position:absolute; left:100%; }

@media (prefers-reduced-motion: no-preference) {
  /* Pre-state only while the head script's motion-ready flag is set (removed after 1.5 s if JS never takes over). */
  :global(.motion-ready) [data-hero]:not([data-motion]) .title,
  :global(.motion-ready) [data-hero]:not([data-motion]) .eyebrow,
  :global(.motion-ready) [data-hero]:not([data-motion]) .corner { opacity:0; }
  [data-hero][data-motion="running"] .corner { animation:hud-lock 600ms var(--ease-precise) both; }
  .title :global(.hero-key:not(.is-drawn) i) { animation:hero-key 500ms var(--ease-precise) both; animation-delay:var(--d); }
  .eyebrow :global(.type-visual > span) { animation:hero-type 1ms steps(1) both; animation-delay:calc(var(--i) * 55ms); }
  .eyebrow :global(.type-visual > span::after) { content:"_"; position:absolute; left:100%; opacity:0; animation:hero-caret-step 55ms steps(1) forwards; animation-delay:calc(var(--i) * 55ms); }
  .eyebrow :global(.type-visual > span.last::after) { animation:hero-caret 1.1s steps(1) 3 forwards; animation-delay:calc(var(--i) * 55ms); }
  .sweep { animation:hud-sweep 9s linear infinite paused; }
  .hud[data-in-view] .sweep { animation-play-state:running; }
  /* The hero's pause control (WCAG 2.2.2) stops the sweep together with the footage. */
  [data-hero]:has([data-toggle][aria-pressed="true"]) .hud .sweep { animation-play-state:paused; }
}
@keyframes hud-lock { from { opacity:0; transform:var(--from); } to { opacity:1; transform:none; } }
@keyframes hud-sweep { from { transform:translateY(-100%); } to { transform:translateY(0); } }
@keyframes hero-key { from { transform:scaleX(0); } to { transform:scaleX(1); } }
@keyframes hero-type { from { opacity:0; } to { opacity:1; } }
@keyframes hero-caret-step { from { opacity:1; } to { opacity:0; } }
@keyframes hero-caret { 0% { opacity:1; } 50% { opacity:0; } 100% { opacity:1; } }
@media (prefers-reduced-motion: reduce) {
  .sweep { display:none; }
  .corner, .title :global(.hero-key i), .eyebrow :global(.type-visual > span), .eyebrow :global(.type-visual > span::after) { animation:none !important; transform:none !important; clip-path:none !important; opacity:1 !important; }
  .eyebrow :global(.type-visual > span:not(.last)::after) { content:none; }
}
</style>
