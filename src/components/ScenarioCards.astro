---
/**
 * Application scenarios as picture cards: 16:9 image on top, then title, scenario
 * description and the training focus. Rows follow the shared count rule; on the phone
 * the text comes first and the picture sits below it in the same card.
 */
import type { ImageMetadata } from "astro";
import MediaSlot from "./MediaSlot.astro";
import Text from "./Text.astro";

type Slot = { src?: ImageMetadata; alt?: string; need?: string; caption?: string; ratio?: string };
interface Props {
  items: { title: string; description: string; focus?: string; image?: Slot }[];
  focusLabel: string;
  needPrefix: string;
  badge?: string;
  fallbackLabel: string;
}
const { items, focusLabel, needPrefix, fallbackLabel, badge } = Astro.props;
---
<ul role="list" class="scenarios balanced">
  {items.map((s) => (
    <li class="card">
      {s.image?.src && <MediaSlot media={s.image} ratio="16 / 9" fallbackLabel={fallbackLabel} needPrefix={needPrefix} badge={badge} sizes="(max-width: 767px) 100vw, 33vw" />}
      <div class="body">
        <h3 class="t-h4"><Text value={s.title} /></h3>
        <p class="desc"><Text value={s.description} /></p>
        {s.focus && <p class="focus t-small"><span class="t-label"><Text value={focusLabel} /></span><Text value={s.focus} /></p>}
      </div>
    </li>
  ))}
</ul>
<style>
  /* Rows follow the shared count rule (.balanced, docs/LAYOUT-RULES.md §1). */
  .scenarios { margin: 0; padding: 0; list-style: none; }
  .card { display: flex; flex-direction: column; background: var(--bxr-white); border: 1px solid var(--bxr-line); }
  .body { display: grid; gap: var(--space-1); align-content: start; flex: 1; padding: var(--space-3); }
  .desc { margin: 0; color: var(--ink-muted); }
  .focus { display: grid; gap: 4px; margin: var(--space-1) 0 0; padding: var(--space-2); background: var(--bxr-paper); color: var(--ink-muted); margin-top: auto; }
  .focus .t-label { color: var(--ink); }
  /* Phone (docs/LAYOUT-RULES.md §2): text first, the picture below it, inside the same card. */
  @media (max-width: 767px) { .card > :global(.media) { order: 2; } .card > .body { order: 1; } }
</style>
<style>
  /* Same feedback as the home product cards: image 1.05 inside its clipped frame, red gradient from the bottom. */
  .card :global(.asset-frame)::after { content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0;
    background: linear-gradient(0deg, color-mix(in srgb, var(--bxr-red) 42%, transparent), transparent 55%); transition: opacity var(--dur-standard) var(--ease-precise); }
  .card :global(.asset-frame img) { transition: transform var(--dur-standard) var(--ease-precise); }
  .card:hover :global(.asset-frame)::after, .card:focus-within :global(.asset-frame)::after { opacity: 1; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) { .card:hover :global(.asset-frame img) { transform: scale(1.05); } }
  @media (prefers-reduced-motion: reduce) { .card :global(.asset-frame)::after, .card :global(.asset-frame img) { transition: none; } }
</style>