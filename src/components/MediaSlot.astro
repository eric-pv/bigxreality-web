---
/**
 * One image position on a landing page. With a photo it renders the optimised picture;
 * without one it shows a CIS placeholder that names the material needed, in a compact
 * preview. Landing images use the shared 16:9 display ratio (docs/LAYOUT-RULES.md).
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Text from "./Text.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  media?: { src?: ImageMetadata; alt?: string; need?: string; caption?: string; ratio?: string; illustration?: boolean };
  /** Legacy caller hint; landing display always follows the shared 16:9 rule. */
  ratio: string;
  /** Label of the placeholder when the slot has no `need`. */
  fallbackLabel: string;
  /** Text before the material description on the placeholder. */
  needPrefix: string;
  sizes?: string;
  eager?: boolean;
  /** Label drawn bottom-right on illustrations (情境示意圖). */
  badge?: string;
}
const { media, fallbackLabel, needPrefix, sizes = "(max-width: 767px) 100vw, 50vw", eager = false } = Astro.props;
// Older CMS entries may still carry another ratio. They must not override the site rule.
const useRatio = "16 / 9";
const ready = media?.src && media.alt;
const label = media?.need ? `${needPrefix}${media.need}` : fallbackLabel;
---
<figure hidden={!ready} class="media" style={`--ratio: ${useRatio}`}>
  {ready ? (
    <div class="frame">
    <Picture
      src={media!.src!} alt={media!.alt!} formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600].filter((w) => w <= media!.src!.width)} sizes={sizes}
      fit="cover" loading={eager ? "eager" : "lazy"}
    />
    </div>
  ) : (
    <ImagePlaceholder label={label} ratio={useRatio} />
  )}
  {media?.caption && <figcaption class="t-caption"><Text value={media.caption} /></figcaption>}
</figure>
<style>
  .media { margin: 0; }
  .frame { position: relative; }
  .badge {
    position: absolute; right: var(--space-1); bottom: var(--space-1); padding: 2px var(--space-1);
    background: rgb(10 12 16 / 0.72); color: var(--bxr-white); font-size: var(--fs-caption, 0.75rem); line-height: 1.5; pointer-events: none;
  }
  .media :global(img) { display: block; width: 100%; height: auto; aspect-ratio: var(--ratio); object-fit: cover; }
  figcaption { margin-top: var(--space-1); color: var(--ink-muted); }
</style>
