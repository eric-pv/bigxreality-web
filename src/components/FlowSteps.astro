---
/**
 * Process with visual guidance: each step has a round icon on a connecting line, an
 * optional picture, a step label, title and text. Desktop: rows by the shared count rule
 * (docs/LAYOUT-RULES.md §1: 5 steps = 3 + 2), the connector stops at the end of each row;
 * tablet and phone: a vertical line with the icon on the left, text first and the picture
 * below it (§2). For a suggested process, not a software procedure.
 */
import type { ImageMetadata } from "astro";
import FlowIcon from "./FlowIcon.astro";
import MediaSlot from "./MediaSlot.astro";
import Text from "./Text.astro";
import { endsRow } from "../lib/layout";

type Slot = { src?: ImageMetadata; alt?: string; need?: string; caption?: string; ratio?: string };
interface Props {
  steps: { title: string; description: string; icon?: "target" | "team" | "variation" | "review" | "route" | "headset" | "link"; image?: Slot }[];
  stepLabel: string;
  needPrefix: string;
  badge?: string;
  fallbackLabel: string;
}
const { steps, stepLabel, needPrefix, fallbackLabel, badge } = Astro.props;
const ICONS = ["target", "team", "variation", "review"] as const;
---
<ol role="list" class="flow balanced" data-reveal>
  {steps.map((s, i) => (
    <li class:list={["step", { "row-end": endsRow(i, steps.length) }]} style={`--i:${i}`}>
      <span class="node"><FlowIcon name={s.icon ?? ICONS[i % ICONS.length]} /></span>
      <div class="body">
        <p class="t-label label"><Text value={stepLabel} /> {String(i + 1).padStart(2, "0")}</p>
        {s.image?.src && <MediaSlot media={s.image} ratio="16 / 9" fallbackLabel={fallbackLabel} needPrefix={needPrefix} badge={badge} sizes="(max-width: 1023px) 80vw, 25vw" />}
        <h3 class="t-h4"><Text value={s.title} /></h3>
        <p class="t-muted"><Text value={s.description} /></p>
      </div>
    </li>
  ))}
</ol>
<style>
  .flow { position: relative; justify-content: flex-start; row-gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .step { position: relative; display: grid; gap: var(--space-3); align-content: start; }
  .step::before { content: ""; position: absolute; top: 31px; left: 64px; right: calc(-1 * var(--gutter)); height: 2px; background: repeating-linear-gradient(90deg, var(--bxr-ash) 0 6px, transparent 6px 12px); }
  .step.row-end::before { display: none; }
  .node { position: relative; z-index: 1; display: grid; place-items: center; width: 64px; height: 64px; background: var(--bxr-black); color: var(--bxr-white); border-bottom: 2px solid var(--bxr-red); }
  .body { display: grid; gap: var(--space-1); align-content: start; }
  .label { color: var(--ink-muted); margin: 0; }
  @media (max-width: 1023px) {
    .flow { flex-direction: column; gap: var(--space-5); }
    .flow > .step { flex: none; width: 100%; }
    .step { grid-template-columns: 64px 1fr; gap: var(--space-3); align-items: start; }
    .step.row-end::before { display: block; }
    .step:last-child::before { display: none; }
    .body:has(:global(.media)) { padding: var(--space-3); background: var(--bxr-white); border: 1px solid var(--bxr-line); border-top: 2px solid var(--bxr-black); }
    .body :global(.media) { order: 2; }
    .step::before { top: 64px; bottom: calc(-1 * var(--space-5)); left: 31px; right: auto; width: 2px; height: auto; background: repeating-linear-gradient(180deg, var(--bxr-ash) 0 6px, transparent 6px 12px); }
  }
</style>
<style>
  /* One-shot reveal (class from the motion controller): each connector draws left → right, icons in turn. */
  @media (prefers-reduced-motion: no-preference) {
    .flow.is-revealed .step::before { animation: flow-draw 700ms var(--ease-precise) both; animation-delay: calc(200ms + var(--i) * 220ms); }
    .flow.is-revealed .node { animation: flow-node 420ms var(--ease-precise) both; animation-delay: calc(var(--i) * 220ms); }
  }
  @keyframes flow-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes flow-node { from { opacity: 0; transform: scale(.85); } to { opacity: 1; transform: none; } }
  @media (max-width: 1023px) { @keyframes flow-draw { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } } }
</style>