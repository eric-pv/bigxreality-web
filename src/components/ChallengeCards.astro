---
/** Problem cards: large number, title, text. Two columns on desktop, with a heavy top rule. */
import Text from "./Text.astro";
interface Props { items: { title: string; description: string }[]; columns?: 1 | 2 }
const { items, columns = 2 } = Astro.props;
---
<ol role="list" class="challenges" data-reveal style={`--cols: ${columns}`}>
  {items.map((c, i) => (
    <li class="item" style={`--i:${i}`}>
      <span class="num t-tech" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <h3 class="t-h4"><Text value={c.title} /></h3>
      <p class="t-muted"><Text value={c.description} /></p>
    </li>
  ))}
</ol>
<style>
  .challenges { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 0 var(--gutter); margin: 0; padding: 0; list-style: none; }
  .item { display: grid; grid-template-columns: 56px 1fr; column-gap: var(--space-2); row-gap: var(--space-1); padding: var(--space-4) 0; border-top: 1px solid var(--bxr-black); }
  .num { grid-row: span 2; font-size: var(--fs-h3); color: var(--ink-muted); line-height: 1.2; }
  .item h3 { grid-column: 2; }
  .item p { grid-column: 2; margin: 0; }
  @media (max-width: 767px) { .challenges { grid-template-columns: 1fr; } .item { grid-template-columns: 44px 1fr; } }
</style>
<style>
  .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: no-preference) {
    .challenges.is-revealed .item { animation: challenge-in 420ms var(--ease-precise) both; animation-delay: calc(var(--i) * 80ms); }
  }
  @keyframes challenge-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
</style>